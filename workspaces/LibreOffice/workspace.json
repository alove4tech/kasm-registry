{
  "description": "LibreOffice productivity workspace for ARM64-based Kasm deployments.",
  "docker_registry": "https://index.docker.io/v1/",
  "image_src": "libreoffice.svg",
  "run_config": {
    "hostname": "kasm"
  },
  "exec_config": {
    "go": {
      "cmd": "bash -c '/dockerstartup/custom_startup.sh --go --url \"$KASM_URL\"'"
    },
    "assign": {
      "cmd": "bash -c '/dockerstartup/custom_startup.sh --assign --url \"$KASM_URL\"'"
    }
  },
  "categories": [
    "Productivity",
    "Office"
  ],
  "friendly_name": "LibreOffice",
  "architecture": [
    "arm64"
  ],
  "compatibility": [
    {
      "version": "1.17.x",
      "image": "kasmweb/libre-office:1.17.0",
      "uncompressed_size_mb": 2200,
      "available_tags": [
        "1.17.0"
      ]
    },
    {
      "version": "1.18.x",
      "image": "kasmweb/libre-office:1.18.0",
      "uncompressed_size_mb": 2200,
      "available_tags": [
        "1.18.0"
      ]
    }
  ],
  "notes": "Validated against Kasm docs and manifest as ARM64-capable. Image size is an estimate until measured locally."
}
