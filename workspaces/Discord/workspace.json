{
  "description": "Discord workspace for ARM64 Kasm deployments using a browser-based desktop app image.",
  "docker_registry": "https://index.docker.io/v1/",
  "image_src": "discord.svg",
  "categories": [
    "Communication"
  ],
  "friendly_name": "Discord",
  "cores": 2,
  "memory": 3072,
  "gpu_count": 0,
  "cpu_allocation_method": "Inherit",
  "run_config": {
    "hostname": "kasm"
  },
  "exec_config": {
    "go": {
      "cmd": "bash -c '/dockerstartup/custom_startup.sh --go --url \"$KASM_URL\"'"
    },
    "assign": {
      "cmd": "bash -c '/dockerstartup/custom_startup.sh --assign --url \"$KASM_URL\"'"
    }
  },
  "require_gpu": false,
  "enabled": false,
  "image_type": "Container",
  "architecture": [
    "arm64"
  ],
  "compatibility": [
    {
      "version": "1.17.x",
      "image": "alove4tech/kasm-discord-arm64:1.17.0",
      "uncompressed_size_mb": 3300,
      "available_tags": [
        "1.17.0"
      ]
    },
    {
      "version": "1.18.x",
      "image": "alove4tech/kasm-discord-arm64:1.18.0",
      "uncompressed_size_mb": 3300,
      "available_tags": [
        "1.18.0"
      ]
    }
  ],
  "notes": "Custom ARM64 Discord workspace scaffold. Intended to run Discord as a browser-based desktop app on top of an ARM64 Kasm desktop image. Disabled until the custom image is built, tested, and published."
}
