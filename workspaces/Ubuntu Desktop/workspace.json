{
  "description": "General-purpose Ubuntu desktop workspace for ARM64-based Kasm deployments.",
  "docker_registry": "https://index.docker.io/v1/",
  "image_src": "ubuntu-desktop.svg",
  "run_config": {
    "hostname": "kasm"
  },
  "exec_config": {
    "go": {
      "cmd": "bash -c '/dockerstartup/custom_startup.sh --go --url \"$KASM_URL\"'"
    },
    "assign": {
      "cmd": "bash -c '/dockerstartup/custom_startup.sh --assign --url \"$KASM_URL\"'"
    }
  },
  "categories": [
    "Desktop",
    "Productivity"
  ],
  "friendly_name": "Ubuntu Desktop",
  "architecture": [
    "arm64"
  ],
  "compatibility": [
    {
      "version": "1.17.x",
      "image": "kasmweb/ubuntu-jammy-desktop:1.17.0",
      "uncompressed_size_mb": 3200,
      "available_tags": [
        "1.17.0"
      ]
    }
  ],
  "notes": "Validated against Kasm docs as ARM64-capable. Uncompressed size is measured separately."
}
