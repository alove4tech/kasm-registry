{
  "description": "General-purpose Ubuntu desktop workspace for ARM64 Kasm deployments.",
  "docker_registry": "https://index.docker.io/v1/",
  "image_src": "ubuntu-desktop.svg",
  "categories": [
    "Desktop",
    "Productivity"
  ],
  "friendly_name": "Ubuntu Desktop",
  "cores": 2,
  "memory": 2768,
  "gpu_count": 0,
  "cpu_allocation_method": "Inherit",
  "run_config": {
    "hostname": "kasm"
  },
  "exec_config": {
    "go": {
      "cmd": "bash -c '/dockerstartup/custom_startup.sh --go --url \"$KASM_URL\"'"
    },
    "assign": {
      "cmd": "bash -c '/dockerstartup/custom_startup.sh --assign --url \"$KASM_URL\"'"
    }
  },
  "require_gpu": false,
  "enabled": true,
  "image_type": "Container",
  "architecture": [
    "arm64"
  ],
  "compatibility": [
    {
      "version": "1.17.x",
      "image": "kasmweb/ubuntu-jammy-desktop:1.17.0-rolling-daily",
      "uncompressed_size_mb": 3200,
      "available_tags": [
        "develop",
        "1.17.0",
        "1.17.0-rolling-weekly",
        "1.17.0-rolling-daily"
      ]
    },
    {
      "version": "1.18.x",
      "image": "kasmweb/ubuntu-jammy-desktop:1.18.0-rolling-daily",
      "uncompressed_size_mb": 3200,
      "available_tags": [
        "develop",
        "1.18.0",
        "1.18.0-rolling-weekly",
        "1.18.0-rolling-daily"
      ]
    }
  ],
  "notes": "Validated against Kasm docs and manifest as ARM64-capable.",
  "arch": "arm64"
}
