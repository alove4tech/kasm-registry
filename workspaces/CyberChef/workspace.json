{
  "description": "CyberChef web app launched in Chromium for encoding, decoding, hashing, and data inspection on ARM64 and AMD64 Kasm deployments.",
  "name": "ghcr.io/alove4tech/kasm-cyberchef",
  "docker_registry": "https://ghcr.io",
  "image_src": "cyberchef.svg",
  "categories": [
    "Security",
    "Productivity"
  ],
  "friendly_name": "CyberChef",
  "cores": 2,
  "memory": 2048,
  "gpu_count": 0,
  "cpu_allocation_method": "Inherit",
  "run_config": {
    "hostname": "kasm"
  },
  "exec_config": {
    "go": {
      "cmd": "bash -c '/dockerstartup/custom_startup.sh --go --url \"https://gchq.github.io/CyberChef/\"'"
    },
    "assign": {
      "cmd": "bash -c '/dockerstartup/custom_startup.sh --assign --url \"https://gchq.github.io/CyberChef/\"'"
    }
  },
  "require_gpu": false,
  "enabled": true,
  "image_type": "Container",
  "architecture": [
    "amd64",
    "arm64"
  ],
  "compatibility": [
    {
      "version": "1.17.x",
      "image": "ghcr.io/alove4tech/kasm-cyberchef:1.17.0-rolling-daily",
      "uncompressed_size_mb": 2967,
      "available_tags": [
        "develop",
        "1.17.0",
        "1.17.0-rolling-weekly",
        "1.17.0-rolling-daily"
      ]
    },
    {
      "version": "1.18.x",
      "image": "ghcr.io/alove4tech/kasm-cyberchef:1.18.0-rolling-daily",
      "uncompressed_size_mb": 2967,
      "available_tags": [
        "develop",
        "1.18.0",
        "1.18.0-rolling-weekly",
        "1.18.0-rolling-daily"
      ]
    }
  ],
  "notes": "Uses a thin multi-arch wrapper image based on kasmweb/chromium so Kasm treats this as a separate installable workspace instead of the already-installed Chromium image. The wrapper image is built and published by GitHub Actions for linux/amd64 and linux/arm64.",
  "arch": "amd64,arm64"
}
